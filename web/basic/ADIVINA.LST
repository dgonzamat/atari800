10 REM ** ADIVINA EL NUMERO **›20 DIM R$(1)›30 N=INT(RND(0)*100)+1:T=0›40 PRINT :PRINT "PENSE UN NUMERO DEL 1 AL 100"›50 PRINT "CUAL ES";:INPUT A:T=T+1›60 IF A<N THEN PRINT "MAS ALTO...":GOTO 50›70 IF A>N THEN PRINT "MAS BAJO...":GOTO 50›80 PRINT "BIEN! LO ADIVINASTE EN ";T;" INTENTOS"›90 PRINT "OTRA VEZ (S/N)";:INPUT R$›100 IF R$="S" THEN 30›110 PRINT "HASTA LA PROXIMA"›