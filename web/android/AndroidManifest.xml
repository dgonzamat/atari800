<?xml version="1.0" encoding="utf-8"?>
<!-- Envoltorio Android de la Biblioteca Atari: una sola actividad con un
     WebView que abre la pagina, que ya trae dentro el emulador y los juegos.
     No hace falta red: todo viaja en assets/atari.html. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dgonzamat.atarixl"
    android:versionCode="6"
    android:versionName="6.0">

    <!-- el disparo del mando tactil vibra, como el boton de verdad -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.Black.NoTitleBar">
        <!-- girar el telefono no reinicia la actividad: reiniciarla mataria
             el juego que esta corriendo -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
